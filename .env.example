# Copia este archivo como `.env.local` y rellena los valores de TU proyecto de Supabase
# (Panel de Supabase → Project Settings → API Keys → "Publishable key").
#
# Son valores PÚBLICOS por diseño: la seguridad la garantizan las políticas RLS
# y las funciones SQL. NUNCA pongas aquí la "service_role key" ni la "secret key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
